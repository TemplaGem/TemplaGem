{
  "name": "templagem",
  "displayName": "TemplaGem",
  "version": "0.0.1",
  "description": "an extension to manage gemini prompts templates",
  "author": "skyzary & iamredl",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:playwright": "playwright test",
    "test:backend": "node scripts/check-backend.mjs",
    "landing": "node scripts/serve-landing.mjs",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,scss,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.2",
    "plasmo": "^0.90.5",
    "playwright": "^1.64.0",
    "prettier": "3.2.4",
    "sass": "^1.70.0",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^5.0.3"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://*/*",
      "http://localhost:4300/*"
    ]
  }
}
